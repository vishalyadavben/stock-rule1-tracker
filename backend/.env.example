# Copy these into your hosting provider's environment variables UI (Railway/Render).
# Never commit a real .env file with actual secrets.

DB_HOST=containers-us-west-1.railway.app
DB_PORT=3306
DB_NAME=railway
DB_USER=root
DB_PASSWORD=your-db-password-from-railway
DB_USE_SSL=true

JWT_SECRET=generate-a-long-random-string-here
JWT_EXPIRATION_MS=86400000

STOCK_API_PROVIDER=ALPHA_VANTAGE
STOCK_API_KEY=your-alpha-vantage-key
STOCK_API_BASE_URL=https://www.alphavantage.co

# This must be your deployed frontend's exact URL (no trailing slash), e.g.:
ALLOWED_ORIGIN=https://rule1-tracker.vercel.app
